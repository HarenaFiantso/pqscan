{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PQSCAN_DOWNLOAD_DIR": "${sourceDir}/build/.downloads"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "static",
      "inherits": "base",
      "displayName": "Optimized release that runs where OpenSSL is not installed",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PQSCAN_STATIC": "ON"
      }
    },
    {
      "name": "valgrind",
      "inherits": "base",
      "displayName": "Debug without sanitizers, tests also run under a memory checker",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PQSCAN_ENABLE_MEMCHECK": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer targets with ASan and UBSan, for a Clang that has libFuzzer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "PQSCAN_ENABLE_LIBFUZZER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "static", "configurePreset": "static" },
    { "name": "valgrind", "configurePreset": "valgrind" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 60 }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "static", "inherits": "base", "configurePreset": "static" },
    {
      "name": "valgrind",
      "inherits": "base",
      "configurePreset": "valgrind",
      "execution": { "noTestsAction": "error", "timeout": 300 }
    }
  ]
}
